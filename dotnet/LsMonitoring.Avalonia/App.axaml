<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LsMonitoring.Avalonia.App"
             RequestedThemeVariant="Light">
             <!-- Светлая тема -->

    <Application.Resources>
        <SolidColorBrush x:Key="BrushAppBackground" Color="#F3F6F8"/>
        <SolidColorBrush x:Key="BrushPanel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushPanelAlt" Color="#F8FBFC"/>
        <SolidColorBrush x:Key="BrushSidebar" Color="#EEF4F7"/>
        <SolidColorBrush x:Key="BrushChrome" Color="#172033"/>
        <SolidColorBrush x:Key="BrushChromeMuted" Color="#D7E3EC"/>
        <SolidColorBrush x:Key="BrushChromeLine" Color="#25324A"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#D8E0E7"/>
        <SolidColorBrush x:Key="BrushBorderStrong" Color="#C3CDD8"/>
        <SolidColorBrush x:Key="BrushText" Color="#182230"/>
        <SolidColorBrush x:Key="BrushMuted" Color="#667085"/>
        <SolidColorBrush x:Key="BrushControl" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushControlHover" Color="#F4F8FB"/>
        <SolidColorBrush x:Key="BrushControlPressed" Color="#E8F0F5"/>
        <SolidColorBrush x:Key="BrushPrimary" Color="#0E8F62"/>
        <SolidColorBrush x:Key="BrushPrimaryHover" Color="#087443"/>
        <SolidColorBrush x:Key="BrushPrimaryPressed" Color="#065F46"/>
        <SolidColorBrush x:Key="BrushAccentA" Color="#1769E0"/>
        <SolidColorBrush x:Key="BrushAccentB" Color="#7A3FB7"/>
        <SolidColorBrush x:Key="BrushSuccess" Color="#087443"/>
        <SolidColorBrush x:Key="BrushWarning" Color="#C47F17"/>
        <SolidColorBrush x:Key="BrushDanger" Color="#D92D20"/>
        <SolidColorBrush x:Key="BrushDangerDark" Color="#B42318"/>
        <SolidColorBrush x:Key="BrushStatusIdle" Color="#94A3B8"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource BrushControl}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushControlHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentA}"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{StaticResource BrushControlPressed}"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Foreground" Value="{StaticResource BrushStatusIdle}"/>
            <Setter Property="Background" Value="#EEF2F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource BrushControl}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentA}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource BrushControl}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushControlHover}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentA}"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        </Style>
    </Application.Styles>
</Application>
