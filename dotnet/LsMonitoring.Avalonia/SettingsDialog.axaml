<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LsMonitoring.Avalonia.SettingsDialog"
        Title="Settings"
        Width="400" Height="400"
        WindowStartupLocation="CenterOwner"
        Background="#0d1117"
        CanResize="False">
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="#e6edf3" Margin="0,0,0,10"/>

        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="15">
            <!-- Gateway IP -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Gateway IP:" VerticalAlignment="Center" Foreground="#8b949e"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="GatewayIpBox"/>

            <!-- Username -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Foreground="#8b949e"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="UsernameBox"/>

            <!-- Password -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Foreground="#8b949e"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBox" PasswordChar="*"/>
            
            <!-- Enable Alarms -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Alarms:" VerticalAlignment="Center" Foreground="#8b949e"/>
            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="EnableAlarmsBox" Content="Enable UI Alarms" Foreground="#e6edf3"/>

            <!-- Telegram -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Telegram:" VerticalAlignment="Center" Foreground="#8b949e"/>
            <CheckBox Grid.Row="4" Grid.Column="1" x:Name="EnableTelegramBox" Content="Enable Telegram Alerts" Foreground="#e6edf3"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Chat IDs:" VerticalAlignment="Center" Foreground="#8b949e"/>
            <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" x:Name="TelegramChatIdsBox" PlaceholderText="e.g. 1234567, 9876543"/>
                <Button Grid.Column="1" x:Name="TestTelegramButton" Content="Test" Margin="8,0,0,0"/>
            </Grid>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Padding="15,6"/>
            <Button x:Name="SaveButton" Content="Save" Padding="15,6" Background="#238636" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
