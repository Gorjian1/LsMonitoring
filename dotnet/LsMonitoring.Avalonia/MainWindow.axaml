<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:LsMonitoring.Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="LsMonitoring.Avalonia.MainWindow"
        Width="1280" Height="800"
        MinWidth="980" MinHeight="620"
        Title="LS-G6 Мониторинг"
        Background="{StaticResource BrushAppBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ── Баннер тревоги (всегда видим при критике) ──────────────── -->
        <Border x:Name="AlarmBanner" Grid.Row="0"
                Background="{StaticResource BrushDangerDark}" IsVisible="False" Padding="14,8">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="⚠" FontSize="20" VerticalAlignment="Center"
                           Foreground="White" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" x:Name="AlarmBannerText"
                           Text="Уведомление" FontSize="14" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Верхняя панель ─────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{StaticResource BrushChrome}"
                BorderBrush="{StaticResource BrushChromeLine}" BorderThickness="0,0,0,1"
                Padding="12,0" Height="40">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">

                <Ellipse Grid.Column="0" x:Name="StatusDot"
                         Width="10" Height="10" Margin="0,0,8,0"
                         Fill="{StaticResource BrushStatusIdle}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" x:Name="GatewayLabel"
                           Text="169.254.0.1" Foreground="{StaticResource BrushChromeMuted}"
                           FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <TextBlock Grid.Column="2" x:Name="ConnectionLabel"
                           Text="Ожидание" Foreground="{StaticResource BrushChromeMuted}"
                           FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Rectangle Grid.Column="3" Width="1" Height="18"
                           Fill="{StaticResource BrushChromeLine}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <TextBlock Grid.Column="4" x:Name="CountdownLabel"
                           Text="" Foreground="{StaticResource BrushChromeMuted}"
                           FontSize="12" VerticalAlignment="Center"/>

                <Grid Grid.Column="5"/>

                <Button Grid.Column="6" x:Name="SettingsButton"
                        Content="⚙ Настройки" Margin="4,0" Padding="10,4" FontSize="12"/>
                <Button Grid.Column="7" x:Name="DiscoverButton"
                        Content="Поиск узлов" Margin="4,0" Padding="10,4" FontSize="12"/>
                <Button Grid.Column="8" x:Name="ExportButton"
                        Content="Экспорт" Margin="4,0" Padding="10,4" FontSize="12"/>
                <Button Grid.Column="9" x:Name="LoadSampleButton"
                        Content="Открыть CSV" Margin="4,0" Padding="10,4" FontSize="12"/>
                <Button Grid.Column="10" x:Name="StartButton"
                        Content="▶ Старт" Margin="4,0" Padding="10,4" FontSize="12"/>
                <Button Grid.Column="11" x:Name="StopButton"
                        Content="■ Стоп" Margin="4,0" Padding="10,4" FontSize="12"/>
            </Grid>
        </Border>

        <!-- ── Основная область: список + контент ─────────────────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="240,*">

            <!-- ── Список узлов ───────────────────────────────────────── -->
            <Border Grid.Column="0" Background="{StaticResource BrushSidebar}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource BrushPanelAlt}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Text="УЗЛЫ"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushMuted}" LetterSpacing="2"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="PollNowButton"
                                    Content="⟳" Width="26" Height="26"
                                    Padding="0" FontSize="14" Margin="4,0"
                                    ToolTip.Tip="Опросить сейчас"/>
                            <Button Grid.Column="2" x:Name="AddNodeButton2"
                                    Content="+" Width="26" Height="26"
                                    Padding="0" FontSize="16"
                                    ToolTip.Tip="Добавить узел"/>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                                       x:Name="NodeSummaryText"
                                       Text="0 узлов" Foreground="{StaticResource BrushMuted}"
                                       FontSize="11" Margin="0,3,0,0"/>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource BrushPanelAlt}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                            Padding="8,6">
                        <Grid ColumnDefinitions="*,72">
                            <TextBox Grid.Column="0" x:Name="NodeIdBox"
                                     PlaceholderText="ID узла" FontSize="12"
                                     Margin="0,0,4,0"/>
                            <Button Grid.Column="1" x:Name="AddNodeButton"
                                    Content="Добавить" FontSize="12"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="NodeList" SelectionMode="Single"
                             Background="Transparent"
                             Padding="6,4">
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem" x:DataType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                    </ControlTemplate>
                                </Setter>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" CornerRadius="6"
                                        Background="{StaticResource BrushPanel}"
                                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                        Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="6,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <Rectangle Grid.Column="0" Grid.RowSpan="5"
                                                   Fill="{Binding StatusColor}"
                                                   Width="4"
                                                   Margin="0,0,8,0" VerticalAlignment="Stretch"/>

                                        <Grid Grid.Column="1" Grid.Row="0"
                                              ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource BrushText}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding AgeText}"
                                                       FontSize="11" Foreground="{StaticResource BrushMuted}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Grid.Column="1" Grid.Row="1"
                                                   Text="{Binding Subtitle}"
                                                   FontSize="11" Foreground="{StaticResource BrushMuted}"
                                                   Margin="0,2,0,4"/>

                                        <Grid Grid.Column="1" Grid.Row="2"
                                              ColumnDefinitions="80,*">
                                            <controls:Sparkline
                                                Points="{Binding SparklineData}"
                                                LineColor="{Binding StatusColor}"
                                                Width="80" Height="20"/>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AText}"
                                                           FontSize="11" Foreground="{StaticResource BrushAccentA}"
                                                           FontFamily="Cascadia Code, Consolas, monospace"/>
                                                <TextBlock Text="{Binding BText}"
                                                           FontSize="11" Foreground="{StaticResource BrushAccentB}"
                                                           FontFamily="Cascadia Code, Consolas, monospace"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Column="1" Grid.Row="3"
                                                   Text="{Binding ZeroText}"
                                                   IsVisible="{Binding HasZero}"
                                                   FontSize="10" Foreground="{StaticResource BrushSuccess}"
                                                   FontFamily="Cascadia Code, Consolas, monospace"
                                                   Margin="0,4,0,0"/>

                                        <StackPanel Grid.Column="1" Grid.Row="4"
                                                    Orientation="Horizontal" Spacing="4"
                                                    Margin="0,6,0,0">
                                            <Button Content="◎ Установить ноль"
                                                    Tag="{Binding NodeId}"
                                                    Click="OnSetZeroClick"
                                                    FontSize="10" Padding="6,2"
                                                    ToolTip.Tip="Зафиксировать текущее значение как ноль"/>
                                            <Button Content="✕ Стереть"
                                                    Tag="{Binding NodeId}"
                                                    Click="OnClearZeroClick"
                                                    IsVisible="{Binding HasZero}"
                                                    FontSize="10" Padding="6,2"
                                                    ToolTip.Tip="Убрать ноль — показывать сырые значения"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ── Контентная область ─────────────────────────────────── -->
            <Grid Grid.Column="1" RowDefinitions="5*,2*" Margin="12,10,12,10" RowSpacing="10">

                <!-- Графики A и B -->
                <Border Grid.Row="0" Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8">
                    <Grid RowDefinitions="34,*,*" RowSpacing="4">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,6,12,0">
                            <TextBlock Text="ГРАФИКИ" FontSize="11" FontWeight="SemiBold"
                                       LetterSpacing="2" Foreground="{StaticResource BrushMuted}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="PlotMetaText"
                                           Text="" Foreground="{StaticResource BrushMuted}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,4,0"
                                           MaxWidth="300"
                                           TextTrimming="CharacterEllipsis"/>
                                <ComboBox x:Name="TimeWindowBox"
                                          Width="92" SelectedIndex="1" FontSize="11">
                                    <ComboBoxItem Content="15 мин" Tag="900"/>
                                    <ComboBoxItem Content="1 час" Tag="3600"/>
                                    <ComboBoxItem Content="6 часов" Tag="21600"/>
                                    <ComboBoxItem Content="Всё" Tag="0"/>
                                </ComboBox>
                                <Button x:Name="LimitPlotButton"
                                        Content="Ограничить"
                                        Padding="10,4"
                                        FontSize="11"
                                        ToolTip.Tip="Показывать только данные после выбранной даты и времени"/>
                                <Button x:Name="PickPlotLimitButton"
                                        Content="🖌"
                                        Width="30" Height="28"
                                        Padding="0"
                                        FontSize="13"
                                        ToolTip.Tip="Выбрать начало ограничения кликом по графику"/>
                                <Button x:Name="ClearPlotLimitButton"
                                        Content="✕"
                                        Width="30" Height="28"
                                        Padding="0"
                                        FontSize="13"
                                        ToolTip.Tip="Сбросить ограничение графика"/>
                            </StackPanel>
                        </Grid>
                        <controls:TrendPlot Grid.Row="1" x:Name="PlotA"
                                            Series="A"
                                            Margin="6,0,10,2"/>
                        <controls:TrendPlot Grid.Row="2" x:Name="PlotB"
                                            Series="B"
                                            Margin="6,0,10,6"/>
                    </Grid>
                </Border>

                <!-- Таблица измерений -->
                <Border Grid.Row="1" Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8"
                        Padding="10,8">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Text="ПОСЛЕДНИЕ ИЗМЕРЕНИЯ" FontSize="11"
                                       FontWeight="SemiBold" LetterSpacing="2"
                                       Foreground="{StaticResource BrushMuted}"/>
                            <TextBlock Grid.Column="1" x:Name="RowsMetaText"
                                       Text="" Foreground="{StaticResource BrushMuted}" FontSize="11"/>
                        </Grid>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="150,62,76,76,76,76,82,82,*"
                              Margin="0,6,0,2">
                            <TextBlock Text="Время" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushMuted}"/>
                            <TextBlock Grid.Column="1" Text="T (°C)" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}"/>
                            <TextBlock Grid.Column="2" Text="A (°)" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}"/>
                            <TextBlock Grid.Column="3" Text="B (°)" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}"/>
                            <TextBlock Grid.Column="4" Text="A-вар" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}"/>
                            <TextBlock Grid.Column="5" Text="B-вар" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}"/>
                            <TextBlock Grid.Column="6" Text="A откл." FontSize="11"
                                       FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}"/>
                            <TextBlock Grid.Column="7" Text="B откл." FontSize="11"
                                       FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}"/>
                            <TextBlock Grid.Column="8" Text="Флаги" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}"/>
                        </Grid>

                        <ListBox Grid.Row="2" x:Name="RowsList"
                                 FontFamily="Cascadia Code, JetBrains Mono, Consolas, monospace"
                                 FontSize="12" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="150,62,76,76,76,76,82,82,*"
                                          MinHeight="22">
                                        <TextBlock Text="{Binding Time}"
                                                   Foreground="{StaticResource BrushMuted}" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Temperature}"
                                                   Foreground="{StaticResource BrushText}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding AAxis}"
                                                   Foreground="{StaticResource BrushAccentA}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding BAxis}"
                                                   Foreground="{StaticResource BrushAccentB}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding AVariation}"
                                                   Foreground="{StaticResource BrushMuted}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding BVariation}"
                                                   Foreground="{StaticResource BrushMuted}"/>
                                        <TextBlock Grid.Column="6" Text="{Binding ADeviation}"
                                                   Foreground="{StaticResource BrushAccentA}"/>
                                        <TextBlock Grid.Column="7" Text="{Binding BDeviation}"
                                                   Foreground="{StaticResource BrushAccentB}"/>
                                        <TextBlock Grid.Column="8" Text="{Binding Flags}"
                                                   Foreground="{StaticResource BrushDanger}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Статус-бар ─────────────────────────────────────────────── -->
        <Border Grid.Row="3" Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                Padding="12,4" Height="26">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock x:Name="StatusText" Text="Ожидание"
                           Foreground="{StaticResource BrushMuted}" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="SamplingRateLabel"
                           Text="" Foreground="{StaticResource BrushMuted}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="2" x:Name="LastSampleLabel"
                           Text="" Foreground="{StaticResource BrushMuted}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="3" x:Name="SourceText"
                           Text="CSV" Foreground="{StaticResource BrushMuted}" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
