<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LsMonitoring.Avalonia.PlotLimitDialog"
        Title="Ограничить график"
        Width="380" Height="250"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushAppBackground}"
        CanResize="False">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock Text="Ограничить график" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
        <TextBlock Text="На графиках останутся только измерения после указанного момента."
                   TextWrapping="Wrap"
                   Foreground="{StaticResource BrushMuted}"
                   FontSize="12"/>

        <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Дата:"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource BrushMuted}"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     x:Name="DateBox"
                     PlaceholderText="20.05.2026"/>

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Время:"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource BrushMuted}"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     x:Name="TimeBox"
                     PlaceholderText="14:30:00"/>
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Text=""
                   Foreground="{StaticResource BrushDanger}"
                   FontSize="11"
                   MinHeight="16"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Padding="12,6"/>
            <Button x:Name="ApplyButton"
                    Content="Применить"
                    Padding="12,6"
                    Background="{StaticResource BrushPrimary}"
                    Foreground="White"
                    BorderBrush="{StaticResource BrushPrimaryHover}"/>
        </StackPanel>
    </StackPanel>
</Window>
