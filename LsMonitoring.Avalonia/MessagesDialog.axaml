<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LsMonitoring.Avalonia.MessagesDialog"
        Title="Оповещения"
        Width="840" Height="640"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushAppBackground}"
        CanResize="True">
    <Window.Styles>
        <Style Selector="Border.channel-card">
            <Setter Property="Background" Value="{StaticResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.form-card">
            <Setter Property="Background" Value="{StaticResource BrushPanelAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.step-index">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BrushAccentTint}"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.dialog-subtitle">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.card-title">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.card-text">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.step-number">
            <Setter Property="Foreground" Value="{StaticResource BrushAccentA}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Foreground" Value="{StaticResource BrushAccentA}"/>
        </Style>
        <Style Selector="Button.link:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryHover}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="14">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Оповещения"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushText}"/>
            <TextBlock Classes="dialog-subtitle"
                       Text="Выберите канал, укажите получателей и отправьте тест."/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="EnableTelegramBox"/>
                        <TextBlock Text="Telegram" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Margin="0,0,8,0">
                        <Border Classes="channel-card">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="card-title" Text="Telegram"/>
                                    <TextBlock Classes="card-text"
                                               Text="Бот пишет в чат при начале тревоги и закрывает сообщение, когда значение вернулось в норму."/>
                                    <StackPanel Spacing="7">
                                        <Grid ColumnDefinitions="26,*">
                                            <Border Classes="step-index">
                                                <TextBlock Classes="step-number" Text="1"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="card-text"
                                                       Text="Отсканируйте QR справа или откройте бота по ссылке: Telegram отправит /start с кодом привязки."/>
                                        </Grid>
                                        <Grid ColumnDefinitions="26,*">
                                            <Border Classes="step-index">
                                                <TextBlock Classes="step-number" Text="2"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="card-text"
                                                       Text="Если ссылка не подставила код, скопируйте код ниже и отправьте боту: /start код."/>
                                        </Grid>
                                        <Grid ColumnDefinitions="26,*">
                                            <Border Classes="step-index">
                                                <TextBlock Classes="step-number" Text="3"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="card-text"
                                                       Text="Нажмите Отправить тест. Поле ID можно оставить пустым — чат подхватится автоматически. Кнопка Отвязать чат очищает получателя."/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Classes="form-card"
                                        Padding="10"
                                        Width="148"
                                        VerticalAlignment="Top">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Бот"
                                                   TextAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushText}"/>
                                        <Border Background="White"
                                                BorderBrush="{StaticResource BrushBorderStrong}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="7"
                                                HorizontalAlignment="Center">
                                            <Image x:Name="TelegramBotQrImage"
                                                   Width="112"
                                                   Height="112"
                                                   Stretch="Uniform"/>
                                        </Border>
                                        <Button x:Name="BotLinkButton"
                                                Classes="link"
                                                Content="@ls_monitoringbot"
                                                HorizontalAlignment="Center"
                                                ToolTip.Tip="Открыть Telegram-бота"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Classes="form-card">
                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Куда слать:"/>
                                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" x:Name="TelegramChatIdsBox"
                                             PlaceholderText="ID чатов: 1234567, 9876543"/>
                                    <Button Grid.Column="1" x:Name="TestTelegramButton"
                                            Content="Отправить тест"
                                            Margin="8,0,0,0"
                                            Padding="12,4"/>
                                    <Button Grid.Column="2" x:Name="UnlinkTelegramButton"
                                            Content="Отвязать чат"
                                            Margin="8,0,0,0"
                                            Padding="12,4"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Код:"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TelegramLinkCodeBox"
                                         IsReadOnly="True"
                                         PlaceholderText="код привязки"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="EnableEmailBox"/>
                        <TextBlock Text="Почта" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Margin="0,0,8,0">
                        <Border Classes="channel-card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="card-title" Text="Email"/>
                                <TextBlock Classes="card-text"
                                           Text="Письма уходят с адреса lsalerts@mail.ru. Получателей укажите ниже."/>
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="26,*">
                                        <Border Classes="step-index">
                                            <TextBlock Classes="step-number" Text="1"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="card-text"
                                                   Text="Введите адреса получателей через запятую."/>
                                    </Grid>
                                    <Grid ColumnDefinitions="26,*">
                                        <Border Classes="step-index">
                                            <TextBlock Classes="step-number" Text="2"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="card-text"
                                                   Text="Нажмите Отправить тест. Проверьте входящие и папку Спам."/>
                                    </Grid>
                                    <Grid ColumnDefinitions="26,*">
                                        <Border Classes="step-index">
                                            <TextBlock Classes="step-number" Text="3"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="card-text"
                                                   Text="Тест дошёл — включите канал галочкой во вкладке и сохраните. Если нужен свой ящик отправителя — раскройте блок Свой SMTP."/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="form-card">
                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Куда слать:"/>
                                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" x:Name="EmailRecipientsBox"
                                             PlaceholderText="boss@example.com, engineer@example.com"/>
                                    <Button Grid.Column="1" x:Name="TestEmailButton"
                                            Content="Отправить тест"
                                            Margin="8,0,0,0"
                                            Padding="12,4"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Окончание:"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="EmailSendResolvedBox"
                                          Content="Отправлять окончание тревоги"/>

                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="EmailStatusText"
                                           Classes="card-text"/>
                            </Grid>
                        </Border>

                        <Expander Header="Свой SMTP" IsExpanded="False">
                            <Border Classes="form-card" Margin="0,8,0,0">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="card-text"
                                               Text="Заполните этот блок, если письма должны уходить через отдельный SMTP-ящик. Для Gmail, Яндекс и Mail.ru часто нужен пароль приложения, а не обычный пароль от ящика."/>
                                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Режим:"/>
                                        <CheckBox Grid.Row="0" Grid.Column="1" x:Name="UseOwnSmtpBox"
                                                  Content="Отправлять через свой SMTP"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Отправитель:"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="EmailFromBox"
                                                 PlaceholderText="monitoring@example.com"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="Пароль:"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="EmailPasswordBox"
                                                 PasswordChar="*" PlaceholderText="пароль приложения"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="field-label" Text="Сервер:"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="EmailSmtpHostBox"
                                                 PlaceholderText="авто: smtp.example.com"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="field-label" Text="Порт:"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="EmailSmtpPortBox"
                                                 PlaceholderText="587"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="field-label" Text="Логин:"/>
                                        <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" x:Name="EmailUsernameBox"
                                                     PlaceholderText="если отличается от отправителя"/>
                                            <CheckBox Grid.Column="1" x:Name="EmailUseSslBox"
                                                      Content="TLS"
                                                      Margin="10,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="EnablePushBox"/>
                        <TextBlock Text="Push" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Margin="0,0,8,0">
                        <Border Classes="channel-card">
                            <Grid ColumnDefinitions="*,148,148" ColumnSpacing="14">
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <TextBlock Classes="card-title" Text="Push на Android"/>
                                    <TextBlock Classes="card-text"
                                               Text="Push приходит через локальный Gotify и временный tunnel localhost.run (по SSH, встроен в Windows)."/>
                                    <StackPanel Spacing="7">
                                        <Grid ColumnDefinitions="26,*">
                                            <Border Classes="step-index">
                                                <TextBlock Classes="step-number" Text="1"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="card-text"
                                                       Text="Отсканируйте телефоном QR Скачать и установите LS Alerts."/>
                                        </Grid>
                                        <Grid ColumnDefinitions="26,*">
                                            <Border Classes="step-index">
                                                <TextBlock Classes="step-number" Text="2"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="card-text"
                                                       Text="Нажмите Запустить tunnel — публичный URL подставится автоматически."/>
                                        </Grid>
                                        <Grid ColumnDefinitions="26,*">
                                            <Border Classes="step-index">
                                                <TextBlock Classes="step-number" Text="3"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Classes="card-text"
                                                       Text="В приложении отсканируйте QR Подключить, разрешите уведомления и нажмите Отправить тест."/>
                                        </Grid>
                                    </StackPanel>
                                    <Border Background="{StaticResource BrushWarningTint}"
                                            BorderBrush="#FCD34D"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10">
                                        <TextBlock Classes="card-text"
                                                   Foreground="{StaticResource BrushWarning}"
                                                   Text="URL временного tunnel меняется после перезагрузки компьютера. Включите Автостарт, чтобы tunnel поднимался вместе с программой."/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="PushDownloadButton"
                                                Content="Скачать APK"
                                                Padding="12,4"/>
                                        <Button x:Name="PushConnectButton"
                                                Content="Коннект"
                                                Padding="12,4"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Classes="form-card"
                                        Padding="10"
                                        Width="148"
                                        VerticalAlignment="Top">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Скачать"
                                                   TextAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushText}"/>
                                        <Border Background="White"
                                                BorderBrush="{StaticResource BrushBorderStrong}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="7"
                                                HorizontalAlignment="Center">
                                            <Image x:Name="PushDownloadQrImage"
                                                   Width="112"
                                                   Height="112"
                                                   Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock x:Name="PushDownloadQrText"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushMuted}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Classes="form-card"
                                        Padding="10"
                                        Width="148"
                                        VerticalAlignment="Top">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Подключить"
                                                   TextAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushText}"/>
                                        <Border Background="White"
                                                BorderBrush="{StaticResource BrushBorderStrong}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="7"
                                                HorizontalAlignment="Center">
                                            <Image x:Name="PushConnectQrImage"
                                                   Width="112"
                                                   Height="112"
                                                   Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock x:Name="PushConnectQrText"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushMuted}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Classes="form-card">
                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Проверка:"/>
                                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*">
                                    <Button Grid.Column="0" x:Name="TestPushButton"
                                            Content="Отправить тест"
                                            Padding="12,4"/>
                                    <TextBlock Grid.Column="1" x:Name="PushStatusText"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushMuted}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Tunnel:"/>
                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto,*">
                                    <Button Grid.Column="0" x:Name="StartPushTunnelButton"
                                            Content="Запустить tunnel"
                                            Padding="12,4"/>
                                    <CheckBox Grid.Column="1" x:Name="PushAutoTunnelBox"
                                              Content="Автостарт"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="PushTunnelStatusText"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushMuted}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Expander Header="Сервисная настройка Gotify" IsExpanded="False">
                            <Border Classes="form-card" Margin="0,8,0,0">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="card-text"
                                               Text="Поля подключения: публичный адрес Gotify, token приложения для отправки тревог, client token для телефона, локальный адрес Gotify и ссылка на APK."/>
                                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Сервер:"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PushServerUrlBox"
                                                 PlaceholderText="https://push.example.com"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="App token:"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="PushAppTokenBox" PasswordChar="*"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="Client token:"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="PushClientTokenBox" PasswordChar="*"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="field-label" Text="Страница APK:"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="PushAppDownloadUrlBox"
                                                 PlaceholderText="https://github.com/Gorjian1/LsMonitoring/releases/latest/download/ls-alerts-latest.apk"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="field-label" Text="Приоритет:"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="PushPriorityBox"
                                                 PlaceholderText="5"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="field-label" Text="Локальный Gotify:"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="PushLocalServerUrlBox"
                                                 PlaceholderText="http://localhost:8080"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="EnableSmsBox"/>
                        <TextBlock Text="SMS" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Margin="0,0,8,0">
                        <Border Classes="channel-card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="card-title" Text="SMS"/>
                                <TextBlock Classes="card-text"
                                           Text="SMS отправляются через sms.ru. Укажите номера, API key и лимит сообщений ниже."/>
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="26,*">
                                        <Border Classes="step-index">
                                            <TextBlock Classes="step-number" Text="1"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="card-text"
                                                   Text="Введите номера получателей через запятую."/>
                                    </Grid>
                                    <Grid ColumnDefinitions="26,*">
                                        <Border Classes="step-index">
                                            <TextBlock Classes="step-number" Text="2"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="card-text"
                                                   Text="Укажите API key sms.ru в настройке SMS-провайдера."/>
                                    </Grid>
                                    <Grid ColumnDefinitions="26,*">
                                        <Border Classes="step-index">
                                            <TextBlock Classes="step-number" Text="3"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="card-text"
                                                   Text="Нажмите Отправить тест. Окончание тревоги включайте только если нужны SMS о восстановлении."/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="form-card">
                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Куда слать:"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="SmsPhonesBox"
                                         PlaceholderText="+79990000000, +79991111111"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Окончание:"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="SmsSendResolvedBox"
                                          Content="Отправлять окончание тревоги"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="Проверка:"/>
                                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*">
                                    <Button Grid.Column="0" x:Name="TestSmsButton"
                                            Content="Отправить тест"
                                            Padding="12,4"/>
                                    <TextBlock Grid.Column="1" x:Name="SmsStatusText"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushMuted}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Expander Header="Настройка SMS-провайдера" IsExpanded="False">
                            <Border Classes="form-card" Margin="0,8,0,0">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="card-text"
                                               Text="По умолчанию используется sms.ru: укажите API key из личного кабинета. Если endpoint отличается, замените URL API."/>
                                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Провайдер:"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="SmsProviderBox"
                                                 PlaceholderText="sms.ru"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="API URL:"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SmsApiUrlBox"
                                                 PlaceholderText="https://sms.ru/sms/send"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="API key:"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="SmsApiKeyBox"
                                                 PasswordChar="*"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="field-label" Text="Отправитель:"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="SmsSenderBox"
                                                 PlaceholderText="опционально"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="field-label" Text="Лимит/час:"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="SmsMaxPerHourBox"
                                                 PlaceholderText="20"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="EnableWebhookBox" IsEnabled="False" ToolTip.Tip="Канал в разработке"/>
                        <TextBlock Text="Webhook" VerticalAlignment="Center" Opacity="0.6"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Margin="0,0,8,0">
                        <Border Classes="channel-card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="card-title" Text="Webhook — в разработке"/>
                                <TextBlock Classes="card-text"
                                           Text="Канал пока не подключён. Отправка событий тревоги во внешний endpoint появится в одном из следующих обновлений."/>
                            </StackPanel>
                        </Border>

                        <Border Classes="form-card" IsVisible="False">
                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Куда слать:"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="WebhookUrlBox"
                                         PlaceholderText="https://example.com/hooks/ls-monitoring"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Секрет:"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="WebhookSecretBox"
                                         PasswordChar="*"
                                         PlaceholderText="опционально"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="CancelButton" Content="Отмена" Padding="15,6"/>
            <Button x:Name="SaveButton" Classes="primary" Content="Сохранить" Padding="15,6"/>
        </StackPanel>
    </Grid>
</Window>
